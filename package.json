{
  "name": "topcaps-ecommerce",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --collectCoverageFrom=js/**/*.js",
    "test:verbose": "jest --verbose",
    "test:ci": "jest --ci --coverage --collectCoverageFrom=js/**/*.js",
    "build": "echo 'No build step needed for static site'",
    "lint": "eslint js/ --ext .js || exit 0",
    "validate:html": "html-validate *.html admin/views/*.html || exit 0"
  },
  "devDependencies": {
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "eslint": "^8.0.0",
    "html-validate": "^8.0.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "js/**/*.js",
      "!js/core/firebase-init.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    },
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}